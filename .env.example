# Confluence base URL, without a trailing slash.
# Server/DC: https://confluence.example.com
# Cloud:     https://confluence.example.com (instance/site base; the adapter
#            appends the /wiki REST base — v2 /wiki/api/v2, v1 /wiki/rest/api)
CONFLUENCE_URL=https://confluence.example.com

# Which deployment flavor to talk to: "server" (Server / Data Center) or
# "cloud". Both providers are fully implemented.
CONFLUENCE_PROVIDER=server

# --- Server/DC authentication (either option A or option B) ---
# Option A: personal access token -> Authorization: Bearer.
# CONFLUENCE_TOKEN=

# Option B: username + password -> Authorization: Basic (base64).
# CONFLUENCE_USERNAME=
# CONFLUENCE_PASSWORD=

# --- Cloud authentication (exactly ONE of the options below) ---
# Option C (primary): account email + API token -> Authorization: Basic
# base64(email:token). Both variables must be set together.
# CONFLUENCE_CLOUD_EMAIL=
# CONFLUENCE_CLOUD_API_TOKEN=

# Option D (secondary): OAuth access token (e.g. 3LO) -> Authorization: Bearer.
# Reuses the same variable as the Server/DC PAT; in cloud mode it is sent as
# Bearer. Cannot be combined with option C.
# CONFLUENCE_TOKEN=

# Server-only credentials: setting CONFLUENCE_USERNAME/CONFLUENCE_PASSWORD in
# cloud mode is rejected as a configuration problem.

# When "true", write tools are not advertised at all (read-only deployments).
CONFLUENCE_READ_ONLY=false

# Extra HTTP headers appended to every request.
# Comma-separated "Name: Value" pairs, e.g. "X-Custom-Trace: abc123, X-Tenant: t1"
CONFLUENCE_CUSTOM_HEADERS=
