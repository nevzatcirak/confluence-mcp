# Confluence base URL, without a trailing slash.
# Server/DC: https://confluence.example.com
# Cloud:     https://confluence.example.com (instance base; the /wiki REST
#            path is added by the Cloud adapter in Phase 4)
CONFLUENCE_URL=https://confluence.example.com

# Which deployment flavor to talk to: "server" (Server / Data Center) or
# "cloud". The Cloud adapter is not implemented yet; "cloud" starts the
# server but every cloud call returns a structured PROVIDER_UNAVAILABLE error.
CONFLUENCE_PROVIDER=server

# --- Authentication (either option A or option B is required) ---
# Option A: personal access token -> Authorization: Bearer.
# CONFLUENCE_TOKEN=

# Option B: username + password -> Authorization: Basic (base64).
# CONFLUENCE_USERNAME=
# CONFLUENCE_PASSWORD=

# When "true", write tools are not advertised at all (read-only deployments).
CONFLUENCE_READ_ONLY=false

# Extra HTTP headers appended to every request.
# Comma-separated "Name: Value" pairs, e.g. "X-Custom-Trace: abc123, X-Tenant: t1"
CONFLUENCE_CUSTOM_HEADERS=
